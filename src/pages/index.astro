---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import SkillsChart from '../components/SkillsChart.astro';
import profilePhoto from '../assets/profile-photo.webp';
import { personal, profile, experiences, education, courses, volunteerWork } from '../data/cv';
import '../styles/web.css';

const lang = 'es';
const year = new Date().getFullYear();
const whatsapp = `https://wa.me/${personal.phone.replace(/\D/g, '')}`;

const navItems = [
  { id: 'perfil', label: 'Perfil' },
  { id: 'experiencia', label: 'Experiencia' },
  { id: 'formacion', label: 'Formación' },
  { id: 'voluntariado', label: 'Voluntariado' },
  { id: 'contacto', label: 'Contacto' },
];
---

<Layout
  title={`${personal.name} – Currículum Profesional`}
  description="Currículum de Félix Vilches: Ingeniero Civil en Computación e Informática, Profesor Técnico Profesional y especialista en Telecomunicaciones en Temuco, Chile."
>
  <!-- Aplica el tema elegido antes de pintar la página (evita un parpadeo claro/oscuro) -->
  <script is:inline slot="head">
    try {
      const t = localStorage.getItem('theme');
      if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
    } catch {}
  </script>
  <header class="header">
    <div class="container header-content">
      <Image
        src={profilePhoto}
        alt={`Foto de perfil de ${personal.shortName}`}
        class="profile-image"
        width={320}
        height={320}
        loading="eager"
        fetchpriority="high"
      />
      <div>
        <h1>{personal.name}</h1>
        <p class="subtitle">{personal.title[lang]}</p>
        <p class="tagline">{personal.subtitle[lang]}</p>
        <div class="header-actions">
          <a class="btn btn-light" href="/print?imprimir=1">
            <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/></svg>
            Descargar CV (PDF)
          </a>
          <a class="btn btn-ghost" href={`mailto:${personal.email}`}>
            <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
            Escribirme
          </a>
          <a class="btn btn-ghost" href="/print-en" hreflang="en">
            <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15 15 0 0 1 0 20 15 15 0 0 1 0-20z"/></svg>
            CV in English
          </a>
        </div>
      </div>
    </div>
  </header>

  <nav class="nav" aria-label="Secciones del currículum">
    <div class="container nav-inner">
      <ul class="nav-links">
        {navItems.map((item) => <li><a href={`#${item.id}`}>{item.label}</a></li>)}
      </ul>
      <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Modo oscuro" aria-pressed="false" hidden>
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
    </div>
  </nav>

  <main class="container">
    <div class="main-content">
      <aside class="sidebar">
        <section class="panel" id="contacto" aria-labelledby="contacto-title">
          <h2 class="section-title" id="contacto-title">Contacto</h2>
          <ul class="contact-list">
            <li>
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
              <a href={`tel:${personal.phone}`}>{personal.phoneDisplay}</a>
            </li>
            <li>
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-12.3 7.4L3 21l2.1-5.6A8.4 8.4 0 1 1 21 11.5z"/></svg>
              <a href={whatsapp} target="_blank" rel="noopener">WhatsApp</a>
            </li>
            <li>
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
              <a href={`mailto:${personal.email}`}>{personal.email}</a>
            </li>
            <li>
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
              <span>{personal.city}</span>
            </li>
            {
              personal.linkedin && (
                <li>
                  <svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM9 9h3.8v1.7h.1c.5-1 1.8-2 3.8-2 4 0 4.8 2.6 4.8 6V21h-4v-5.6c0-1.3 0-3-1.9-3s-2.1 1.4-2.1 2.9V21H9z"/></svg>
                  <a href={personal.linkedin} target="_blank" rel="noopener">LinkedIn</a>
                </li>
              )
            }
            {
              personal.github && (
                <li>
                  <svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.9 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A11.5 11.5 0 0 0 12 .5z"/></svg>
                  <a href={personal.github} target="_blank" rel="noopener">GitHub</a>
                </li>
              )
            }
          </ul>
        </section>

        <section class="panel" id="aptitudes" aria-labelledby="aptitudes-title">
          <h2 class="section-title" id="aptitudes-title">Aptitudes</h2>
          <SkillsChart lang={lang} />
        </section>
      </aside>

      <div class="content">
        <section class="content-section" id="perfil" aria-labelledby="perfil-title">
          <h2 class="content-title" id="perfil-title">Perfil Profesional</h2>
          <p class="profile-content">{profile[lang]}</p>
        </section>

        <section class="content-section" id="experiencia" aria-labelledby="experiencia-title">
          <h2 class="content-title" id="experiencia-title">Experiencia Laboral</h2>
          <ol class="timeline">
            {
              experiences.map((exp) => (
                <li class="card">
                  <div class="card-header">
                    <h3 class="card-title">{exp.title[lang]}</h3>
                    <p class="card-period">{exp.period[lang]}</p>
                  </div>
                  <p class="card-org">{exp.company}</p>
                  <p>{exp.description[lang]}</p>
                  {exp.responsibilities && (
                    <ul class="bullets">
                      {exp.responsibilities.map((r) => (
                        <li>{r[lang]}</li>
                      ))}
                    </ul>
                  )}
                </li>
              ))
            }
          </ol>
        </section>

        <section class="content-section" id="formacion" aria-labelledby="formacion-title">
          <h2 class="content-title" id="formacion-title">Formación Académica</h2>

          <h3 class="subsection-title">Antecedentes Académicos</h3>
          <ul class="card-list card-list-plain">
            {
              education.map((edu) => (
                <li class="card">
                  <div class="card-header">
                    <h4 class="card-title">{edu.degree[lang]}</h4>
                    <p class="card-period">{edu.period}</p>
                  </div>
                  <p class="card-org">
                    {edu.institution} {edu.status && <span class="status">{edu.status[lang]}</span>}
                  </p>
                </li>
              ))
            }
          </ul>

          <h3 class="subsection-title">Cursos Complementarios</h3>
          <ul class="courses">
            {
              courses.map((course) => (
                <li class="course">
                  <h4>{course.title}</h4>
                  {course.description && <p>{course.description[lang]}</p>}
                  {(course.period || course.institution) && (
                    <p class="meta">{[course.institution, course.period?.[lang]].filter(Boolean).join(' · ')}</p>
                  )}
                </li>
              ))
            }
          </ul>
        </section>

        <section class="content-section" id="voluntariado" aria-labelledby="voluntariado-title">
          <h2 class="content-title" id="voluntariado-title">Trabajo Voluntario</h2>
          <ul class="card-list card-list-plain">
            {
              volunteerWork.map((v) => (
                <li class="card">
                  <div class="card-header">
                    <h3 class="card-title">{v.title[lang]}</h3>
                    <p class="card-period">{v.period}</p>
                  </div>
                  <p class="card-org">{v.organization[lang]}</p>
                  <p>{v.description[lang]}</p>
                  <ul class="bullets">
                    {v.responsibilities.map((r) => (
                      <li>{r[lang]}</li>
                    ))}
                  </ul>
                </li>
              ))
            }
          </ul>
        </section>
      </div>
    </div>
  </main>

  <footer class="footer">
    <div class="container">
      <p>&copy; {year} {personal.name}</p>
      <p>Sitio desarrollado con <a href="https://astro.build" target="_blank" rel="noopener">Astro</a></p>
    </div>
  </footer>

  <script>
    // Botón de tema: por defecto sigue al sistema; si el visitante elige otro modo, se recuerda.
    // Si elige el mismo modo de su sistema, se borra la elección y vuelve a seguir al sistema.
    const root = document.documentElement;
    const toggle = document.getElementById('theme-toggle');
    const systemDark = window.matchMedia('(prefers-color-scheme: dark)');
    const isDark = () => (root.dataset.theme ?? (systemDark.matches ? 'dark' : 'light')) === 'dark';

    const sync = () => {
      const dark = isDark();
      toggle?.setAttribute('aria-pressed', String(dark));
      toggle?.setAttribute('aria-label', dark ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro');
    };

    if (toggle) {
      toggle.hidden = false;
      sync();
      toggle.addEventListener('click', () => {
        const next = isDark() ? 'light' : 'dark';
        const system = systemDark.matches ? 'dark' : 'light';
        try {
          if (next === system) {
            delete root.dataset.theme;
            localStorage.removeItem('theme');
          } else {
            root.dataset.theme = next;
            localStorage.setItem('theme', next);
          }
        } catch {
          root.dataset.theme = next;
        }
        sync();
      });
      systemDark.addEventListener('change', sync);
    }

    // Resalta en el menú la sección visible.
    const links = new Map(
      [...document.querySelectorAll<HTMLAnchorElement>('.nav-links a')].map((a) => [a.hash.slice(1), a])
    );

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          links.forEach((a) => a.removeAttribute('aria-current'));
          const active = links.get(entry.target.id);
          active?.setAttribute('aria-current', 'true');
          active?.scrollIntoView({ block: 'nearest', inline: 'nearest' });
        }
      },
      { rootMargin: '-30% 0px -60% 0px' }
    );

    // En escritorio "Contacto" es la barra lateral junto a "Perfil": no se sigue para no competir con él.
    const twoColumns = window.matchMedia('(min-width: 901px)').matches;

    links.forEach((_, id) => {
      if (twoColumns && id === 'contacto') return;
      const section = document.getElementById(id);
      if (section) observer.observe(section);
    });
  </script>
</Layout>
